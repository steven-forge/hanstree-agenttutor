# Names only. Leave values empty in git. See README.md for where each name is read.
# .gitignore ignores .env* except this example.

# Next.js server / Vercel. Public pages render committed JSON and do not require these.
CARD_NEWS_ADMIN_PASSWORD=
CARD_NEWS_SIGNING_SECRET=
CARD_NEWS_CRON_SECRET=
CARD_NEWS_PUBLIC_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEWSLETTER_REDIS_REST_URL=
NEWSLETTER_REDIS_REST_TOKEN=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_API_VERSION=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# Python collection scripts. Update Content passes GITHUB_TOKEN from the Actions token.
GITHUB_TOKEN=
YOUTUBE_API_KEY=
X_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
